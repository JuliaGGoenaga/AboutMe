---
import '../styles/global.css';
import { url } from '../lib/images';
import type { ImageMetadata } from 'astro';
import { contact, featured } from '../data/content';

// Logos de los destacados: los nuevos en SVG (se tiñen con el color del texto) y
// los de Wix en PNG, usados como máscara para que también se tiñan
const svgLogos = import.meta.glob<string>('../assets/logos/*.svg', { query: '?raw', import: 'default', eager: true });
const pngLogos = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*.png', { eager: true });

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const home = url();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={home}>Julia Gómez Goenaga</a>
      <nav aria-label="Main">
        <a href={`${home}#present`}>Present</a>
        <a href={`${home}#path`}>Path</a>
        <a href={`${home}#publications`}>Publications</a>
        <a href={`${home}#contact`}>Contact</a>
      </nav>
      <details class="featured">
        <summary>Featured projects</summary>
        <ol>
          {featured.map((f, k) => (
            <li>
              <a href={url(f.href)}>
                {svgLogos[`../assets/logos/${f.logo}.svg`] ? (
                  <span class="logo" set:html={svgLogos[`../assets/logos/${f.logo}.svg`]} />
                ) : pngLogos[`../assets/logos/${f.logo}.png`] ? (
                  <span class="logo"><span class="mask" style={`--m:url(${pngLogos[`../assets/logos/${f.logo}.png`].default.src})`} /></span>
                ) : null}
                <span class="n">{String(k + 1).padStart(2, '0')}</span>
                <strong>{f.title}</strong>
                <span class="note">{f.note}</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Julia Gómez Goenaga</span>
      <a href={url('archive/')}>Archive</a>
      <a href={url('other/')}>Other stuff</a>
      <a href={contact.linkedin}>LinkedIn</a>
    </footer>
  </body>
</html>

<script>
  // El desplegable de destacados se cierra al pulsar fuera o con Escape
  const menu = document.querySelector<HTMLDetailsElement>('details.featured');
  document.addEventListener('click', (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    height: 64px;
    padding: 0 var(--gutter);
    /* Velo de papel para que el menú se lea sobre la ciudad */
    background: linear-gradient(to bottom, var(--paper) 35%, color-mix(in srgb, var(--paper) 0%, transparent));
  }
  .brand {
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    margin-left: auto;
    display: flex;
    gap: clamp(14px, 2.2vw, 28px);
    font-size: 15px;
  }
  nav a {
    text-decoration: none;
    color: var(--ink-2);
  }
  nav a:hover {
    color: var(--ink);
  }
  @media (max-width: 720px) {
    nav {
      display: none;
    }
  }
  /* Destacados: una pastilla con el acento y una lista desplegable */
  .featured {
    position: relative;
    font-size: 15px;
  }
  .featured summary {
    list-style: none;
    cursor: pointer;
    padding: 6px 14px;
    border: 1px solid var(--minio);
    border-radius: 999px;
    color: var(--minio);
    white-space: nowrap;
  }
  .featured summary::-webkit-details-marker {
    display: none;
  }
  .featured summary:hover,
  .featured[open] summary {
    background: var(--minio);
    color: var(--paper);
  }
  /* Panel ancho bajo la cabecera: las opciones en horizontal, cada una con su dibujo */
  .featured ol {
    position: fixed;
    left: var(--gutter);
    right: var(--gutter);
    top: 64px;
    margin: 0 auto;
    max-width: 1280px;
    padding: 20px;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    background: var(--paper);
    border: 1px solid var(--ink);
    box-shadow: 0 24px 60px -30px rgb(0 0 0 / 0.4);
  }
  .featured ol a {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 8px;
    row-gap: 2px;
    text-decoration: none;
  }
  .featured .logo {
    grid-column: 1 / -1;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-top: 1px solid var(--ink);
    margin-bottom: 8px;
    color: var(--ink);
    transition:
      color 0.2s ease,
      transform 0.25s ease;
  }
  .featured .logo :global(svg),
  .featured .logo .mask {
    width: 70%;
    height: 90%;
  }
  .featured .logo .mask {
    display: block;
    background: currentColor;
    -webkit-mask: var(--m) center / contain no-repeat;
    mask: var(--m) center / contain no-repeat;
  }
  .featured ol a:hover .logo {
    color: var(--minio);
    transform: translateY(-3px);
  }
  .featured .n {
    grid-row: span 2;
    color: var(--ink-3);
    font-size: 13px;
    padding-top: 2px;
  }
  .featured strong {
    font-weight: 540;
    line-height: 1.25;
  }
  .featured .note {
    font-size: 13px;
    color: var(--ink-3);
  }
  .featured ol a:hover strong {
    color: var(--minio);
  }
  /* En el móvil, una lista con el logo pequeño a la izquierda */
  @media (max-width: 720px) {
    .featured ol {
      left: 0;
      right: 0;
      grid-template-columns: 1fr;
      gap: 0;
      padding: 8px var(--gutter);
      max-height: calc(100dvh - 80px);
      overflow-y: auto;
      border-left: 0;
      border-right: 0;
    }
    .featured li + li {
      border-top: 1px solid var(--line);
    }
    .featured ol a {
      grid-template-columns: 52px auto 1fr;
      align-items: center;
      column-gap: 12px;
      padding: 10px 0;
    }
    .featured .logo {
      grid-column: 1;
      grid-row: span 2;
      width: 52px;
      aspect-ratio: 1;
      margin: 0;
      border-top: 0;
    }
    .featured .logo :global(svg),
    .featured .logo .mask {
      width: 100%;
      height: 100%;
    }
    .featured .n {
      grid-column: 2;
      grid-row: span 2;
      padding: 0;
    }
    .featured strong,
    .featured .note {
      grid-column: 3;
    }
  }
</style>
