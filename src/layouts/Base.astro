---
import '../styles/global.css';
import { url } from '../lib/images';
import { contact } from '../data/content';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const home = url();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={home}>Julia Gómez Goenaga</a>
      <nav aria-label="Main">
        <a href={`${home}#present`}>Present</a>
        <a href={`${home}#path`}>Path</a>
        <a href={`${home}#publications`}>Publications</a>
        <a href={`${home}#contact`}>Contact</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Julia Gómez Goenaga</span>
      <a href={url('archive/')}>Archive</a>
      <a href={url('other/')}>Other stuff</a>
      <a href={contact.linkedin}>LinkedIn</a>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    height: 64px;
    padding: 0 var(--gutter);
    /* Velo de papel para que el menú se lea sobre la ciudad */
    background: linear-gradient(to bottom, var(--paper) 35%, color-mix(in srgb, var(--paper) 0%, transparent));
  }
  .brand {
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: clamp(14px, 2.2vw, 28px);
    font-size: 15px;
  }
  nav a {
    text-decoration: none;
    color: var(--ink-2);
  }
  nav a:hover {
    color: var(--ink);
  }
  @media (max-width: 720px) {
    nav {
      display: none;
    }
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    padding: 28px var(--gutter);
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--ink-2);
  }
  .site-footer span {
    margin-right: auto;
  }
</style>
