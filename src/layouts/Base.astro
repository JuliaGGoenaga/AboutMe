---
import '../styles/global.css';
import { url } from '../lib/images';
import { contact, featured } from '../data/content';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const home = url();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={home}>Julia Gómez Goenaga</a>
      <nav aria-label="Main">
        <a href={`${home}#present`}>Present</a>
        <a href={`${home}#path`}>Path</a>
        <a href={`${home}#publications`}>Publications</a>
        <a href={`${home}#contact`}>Contact</a>
      </nav>
      <details class="featured">
        <summary>Featured projects</summary>
        <ol>
          {featured.map((f, k) => (
            <li>
              <a href={url(f.href)}>
                <span class="n">{String(k + 1).padStart(2, '0')}</span>
                <strong>{f.title}</strong>
                <span class="note">{f.note}</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Julia Gómez Goenaga</span>
      <a href={url('archive/')}>Archive</a>
      <a href={url('other/')}>Other stuff</a>
      <a href={contact.linkedin}>LinkedIn</a>
    </footer>
  </body>
</html>

<script>
  // El desplegable de destacados se cierra al pulsar fuera o con Escape
  const menu = document.querySelector<HTMLDetailsElement>('details.featured');
  document.addEventListener('click', (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    height: 64px;
    padding: 0 var(--gutter);
    /* Velo de papel para que el menú se lea sobre la ciudad */
    background: linear-gradient(to bottom, var(--paper) 35%, color-mix(in srgb, var(--paper) 0%, transparent));
  }
  .brand {
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    margin-left: auto;
    display: flex;
    gap: clamp(14px, 2.2vw, 28px);
    font-size: 15px;
  }
  nav a {
    text-decoration: none;
    color: var(--ink-2);
  }
  nav a:hover {
    color: var(--ink);
  }
  @media (max-width: 720px) {
    nav {
      display: none;
    }
  }
  /* Destacados: una pastilla con el acento y una lista desplegable */
  .featured {
    position: relative;
    font-size: 15px;
  }
  .featured summary {
    list-style: none;
    cursor: pointer;
    padding: 6px 14px;
    border: 1px solid var(--minio);
    border-radius: 999px;
    color: var(--minio);
    white-space: nowrap;
  }
  .featured summary::-webkit-details-marker {
    display: none;
  }
  .featured summary:hover,
  .featured[open] summary {
    background: var(--minio);
    color: var(--paper);
  }
  .featured ol {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: min(360px, calc(100vw - 2 * var(--gutter)));
    margin: 0;
    padding: 6px 0;
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--ink);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.35);
  }
  .featured li + li {
    border-top: 1px solid var(--line);
  }
  .featured ol a {
    display: grid;
    grid-template-columns: 2.2em 1fr;
    column-gap: 6px;
    padding: 12px 18px;
    text-decoration: none;
  }
  .featured .n {
    grid-row: span 2;
    color: var(--ink-3);
    font-size: 13px;
    padding-top: 3px;
  }
  .featured strong {
    font-weight: 540;
  }
  .featured .note {
    font-size: 13px;
    color: var(--ink-3);
  }
  .featured ol a:hover strong {
    color: var(--minio);
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    padding: 28px var(--gutter);
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--ink-2);
  }
  .site-footer span {
    margin-right: auto;
  }
</style>
