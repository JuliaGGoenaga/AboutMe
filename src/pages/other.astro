---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { contact } from '../data/content';
import { imagesFor } from '../lib/images';

const imgs = imagesFor('other');
// 01-04 logos · 05-20 iconos de las mesas del sitting · 21 foto del sitting
const otherSections = [
  {
    id: 'weddings',
    title: 'Weddings and communions',
    text: 'Invitations, seating plans and table icons, each table named after a place that mattered to the couple and drawn by hand. And illustrated cards for first communions.',
    items: [imgs[20], ...imgs.slice(4, 20), ...imagesFor('other-communions')],
    cover: true,
  },
  { id: 'logos', title: 'Logos', text: '', items: imgs.slice(0, 4), cover: false },
  {
    id: 'graphic',
    title: 'Posters and other graphic design',
    text: 'Posters, flyers and a roll-up for student residences and courses, and line drawings.',
    items: imagesFor('other-posters'),
    cover: false,
  },
];
---

<Base title="Other stuff | Julia Gómez Goenaga" description="Graphic design by Julia Gómez Goenaga: logos, invitations and illustration.">
  <div class="other">
    <h1>Other stuff</h1>
    <p class="lead">
      Graphic design on the side, for friends and family: logos, wedding invitations and seating plans, and a lot of
      line drawings. Some of it lives on <a href={contact.instagram}>Instagram</a>.
    </p>

    {
      otherSections.map((sec) => (
        <section aria-labelledby={sec.id} id={sec.id}>
          <h2 id={sec.id}>{sec.title}</h2>
          {sec.text && <p class="sec-text">{sec.text}</p>}
          <ul class="grid">
            {sec.items.map((img, k) => (
              <li class={sec.cover && k === 0 ? 'photo' : ''}>
                <Image src={img} alt="" widths={[400, 800, 1200]} sizes="(max-width: 700px) 50vw, 25vw" loading={k < 4 ? 'eager' : 'lazy'} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .other {
    padding: 112px var(--gutter) 72px;
  }
  h1 {
    margin: 0;
    font-size: clamp(48px, 9vw, 128px);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .lead {
    margin: 16px 0 0;
    max-width: 58ch;
    font-size: clamp(18px, 1.6vw, 22px);
    color: var(--ink-2);
  }
  section {
    margin-top: 72px;
    padding-top: 20px;
    border-top: 1px solid var(--ink);
  }
  h2 {
    margin: 0 0 12px;
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 560;
    letter-spacing: -0.02em;
  }
  .grid {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(220px, 45%), 1fr));
    gap: 16px;
  }
  .sec-text {
    margin: 0;
    max-width: 60ch;
    color: var(--ink-2);
  }
  .grid .photo {
    grid-column: span 2;
    grid-row: span 2;
  }
  .grid .photo :global(img) {
    height: 100%;
    object-fit: cover;
    padding: 0;
  }
  .grid :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    background: #fff;
    border: 1px solid var(--line);
    padding: 16px;
  }
</style>
