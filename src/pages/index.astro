---
import Base from '../layouts/Base.astro';
import Soleamiento from '../components/Soleamiento.astro';
import Network from '../components/Network.astro';
import Lines from '../components/Lines.astro';
import { publications, contact } from '../data/content';

const affiliations = ['IDOM', 'Universidad de Navarra', 'University of Florida', 'ETSAM, Universidad Politécnica de Madrid'];
---

<Base
  title="Julia Gómez Goenaga, architect and researcher"
  description="Julia Gómez Goenaga is an architect and researcher working on daylight and radiation analysis, computational design and AI for sustainable buildings."
>
  <Soleamiento />

  <ul class="affiliations" aria-label="Affiliations">
    {affiliations.map((a) => <li>{a}</li>)}
  </ul>

  <section id="present" class="section present">
    <div class="intro">
      <h2>Present</h2>
      <p class="body">
        I’m an architect specialized in sustainable design, currently working at IDOM, where I help integrate technical
        innovation into architectural practice. Over the past years, I’ve contributed to numerous real-world façade
        projects, applying performance-based methodologies to optimize design processes and support decarbonization
        goals.
      </p>
      <p class="body">
        I hold a degree in Architecture from ETSAM (Universidad Politécnica de Madrid) and a Master’s in Architecture and
        Sustainability from the University of Navarra. I’m currently pursuing a practice-based PhD through a
        collaboration between IDOM, the University of Navarra, and the University of Florida.
      </p>
      <p class="body">
        My research explores how artificial intelligence can enhance early-stage façade design, leveraging
        data-informed strategies and simulation tools to enable more intelligent, efficient, and environmentally
        responsive decision-making from the very beginning of the creative process. My goal is to advance
        architectural workflows by integrating AI, simulation, and data-driven design into mainstream practice,
        fostering a new generation of buildings that are not only aesthetically compelling but also technically
        optimized and environmentally conscious.
      </p>
      <p class="hint">Three lines of work, and where they meet.</p>
    </div>
    <Lines />
  </section>

  <Network />

  <section id="publications" class="section">
    <h2>Publications</h2>
    <p class="lead">Research on digital workflows and performance-driven envelope design. More about the PhD in its bubble, in the path above.</p>
    <table class="pubs">
      <thead>
        <tr><th>Year</th><th>Title</th><th>Type</th><th>Published in</th></tr>
      </thead>
      <tbody>
        {
          publications.map((p) => (
            <tr>
              <td>{p.year}</td>
              <td>
                {p.href ? <a href={p.href}>{p.title}</a> : p.title}
                {p.authors && <span class="authors">{p.authors}</span>}
              </td>
              <td>{p.type}</td>
              <td>{p.venue}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section id="engagement" class="section">
    <h2>Engagement</h2>
    <p class="lead">
      I take part in World Youth Alliance and other international organisations, and I have worked on projects in
      Spain, the United States, Denmark, Ireland, Saudi Arabia and Africa.
    </p>
  </section>

  <section id="contact" class="section contact">
    <h2>Contact</h2>
    <p class="lead">Happy to talk about daylight, envelopes, computational design and tools that help architects decide.</p>
    <p class="mail"><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
    <p><a href={contact.linkedin}>LinkedIn</a></p>
  </section>
</Base>

<style>
  .affiliations {
    list-style: none;
    margin: 0;
    padding: 18px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 40px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
    font-weight: 500;
  }
  .section {
    padding: clamp(72px, 10vw, 128px) var(--gutter);
    border-top: 1px solid var(--line);
  }
  .affiliations + .section {
    border-top: 0;
  }
  h2 {
    margin: 0;
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 560;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }
  .lead {
    max-width: 60ch;
    font-size: clamp(18px, 1.5vw, 21px);
    color: var(--ink-2);
    margin: 16px 0 0;
  }
  /* Altura extra para que, al bajar, se abran las tres líneas y el centro */
  .present {
    min-height: 260vh;
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 40px clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .present :global(.lines) {
    position: sticky;
    top: 96px;
    align-self: start;
  }
  /* El texto se queda fijo mientras se van marcando las burbujas */
  .intro {
    display: grid;
    gap: 0;
    align-self: start;
    position: sticky;
    top: 96px;
  }
  @media (max-width: 900px) {
    .intro {
      position: static;
    }
  }
  /* Todo el texto de Present al mismo tamaño */
  .body {
    margin: 16px 0 0;
    max-width: 72ch;
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.6;
    color: var(--ink-2);
  }
  .hint {
    margin: 32px 0 0;
    font-size: 14px;
    color: var(--ink-3);
  }
  @media (max-width: 900px) {
    .present {
      grid-template-columns: 1fr;
      min-height: 0;
    }
  }

  .pubs {
    margin-top: 40px;
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .pubs th {
    text-align: left;
    font-weight: 500;
    color: var(--ink-3);
    font-size: 13px;
    padding: 0 16px 10px 0;
  }
  .pubs td {
    padding: 14px 16px 14px 0;
    border-top: 1px solid var(--line);
    vertical-align: top;
  }
  .pubs td:first-child {
    width: 4.5em;
  }
  .authors {
    display: block;
    margin-top: 4px;
    font-size: 13px;
    color: var(--ink-3);
  }
  @media (max-width: 720px) {
    .pubs thead {
      display: none;
    }
    .pubs tr {
      display: grid;
      grid-template-columns: 4em 1fr;
      border-top: 1px solid var(--line);
      padding: 12px 0;
    }
    .pubs td {
      border: 0;
      padding: 2px 0;
    }
    .pubs td:nth-child(n + 3) {
      grid-column: 2;
      color: var(--ink-3);
      font-size: 13px;
    }
  }

  .contact .mail {
    margin: 32px 0 8px;
    font-size: clamp(22px, 3vw, 36px);
    font-weight: 540;
  }
</style>
