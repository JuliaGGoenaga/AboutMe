---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { archive, archiveGroups } from '../../data/content';
import { imagesFor, url } from '../../lib/images';
import Compose from '../../components/Compose.astro';
import Sheet from '../../components/Sheet.astro';
import Scroller from '../../components/Scroller.astro';
import type { ImageMetadata } from 'astro';
import { sheets, usedArchive } from '../../data/sheets';

export function getStaticPaths() {
  return archive.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project: p } = Astro.props;
// Las imágenes que ya salen en la composición no se repiten en la galería.
const composed = (Boolean(sheets[p.slug]) && !sheets[p.slug].bleed && !sheets[p.slug].pair) || p.slug === 'cartagena';
const composeAll = import.meta.glob<{ default: ImageMetadata }>('../../assets/compose/*/*.jpg', { eager: true });
const scrollerRef = sheets[p.slug]?.scroller ?? (p.slug === 'cartagena' ? 'c:sheets' : undefined);
const scrollerImg = scrollerRef ? composeAll[`../../assets/compose/${p.slug}/${scrollerRef.slice(2)}.jpg`]?.default : undefined;
const hidden = [...(p.hideImages ?? []), ...usedArchive(p.slug)];
const imgs = imagesFor(p.slug).filter((_, k) => !hidden.includes(k + 1));
// Retícula alineada: las panorámicas a todo el ancho, las verticales estrechas,
// el resto alternando 7 y 5 columnas.
let alt = 0;
const span = (w: number, h: number) => {
  const r = w / h;
  if (r > 1.9) return 'full';
  if (r < 0.8) return 'tall';
  return alt++ % 2 ? 'b' : 'a';
};
const group = archiveGroups[p.group];
const siblings = archive.filter((x) => x.group === p.group);
const i = siblings.findIndex((x) => x.slug === p.slug);
const next = siblings[(i + 1) % siblings.length];
---

<Base title={`${p.title} | Julia Gómez Goenaga`} description={`${p.title}. ${p.subtitle}.`}>
  <article class="project">
    <header>
      <nav class="crumbs" aria-label="Back">
        <a class="back" href={url(`#open-${p.group}`)}>Back to the {group.title} bubble</a>
        <a class="back" href={url('archive/')}>Archive</a>
      </nav>
      <h1>{p.title}</h1>
      <p class="sub">{p.subtitle}</p>
      <dl class="facts">
        <div><dt>Place</dt><dd>{p.place}</dd></div>
        {p.year && <div><dt>Year</dt><dd>{p.year}</dd></div>}
        <div><dt>Context</dt><dd>{group.subtitle}</dd></div>
      </dl>
    </header>

    {
      !composed && (
        <div class="text">
          {p.text.map((t) => <p>{t}</p>)}
          {p.links && (
            <ul class="links">
              {p.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }

    {sheets[p.slug] && <Sheet project={p} />}
    {p.slug === 'cartagena' && <Compose project={p} />}
    {
      p.slug === 'cartagena' && p.links && (
        <ul class="links">
          {p.links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="gallery">
      {
        imgs.map((img, k) => (
          <figure class={span(img.width, img.height)}>
            <Image
              src={img}
              alt={`${p.title}, image ${k + 1}`}
              widths={[640, 1200, 1800]}
              sizes="(max-width: 800px) 100vw, 60vw"
              loading={k < 2 ? 'eager' : 'lazy'}
            />
          </figure>
        ))
      }
    </div>
    {p.credit && <p class="credit">{p.credit}</p>}

    {scrollerImg && <Scroller src={scrollerImg} alt={`${p.title}, all the project sheets`} label={p.slug === 'cartagena' ? 'All the sheets' : 'Full panel'} />}

    <!-- Visor: al hacer clic en un dibujo se abre en grande sobre papel translúcido -->
    <dialog class="viewer" aria-label="Drawing">
      <button type="button" class="viewer-close">Close</button>
      <img alt="" />
    </dialog>

    <nav class="next" aria-label="Next project">
      <a href={url(`archive/${next.slug}/`)}>
        <span>Next</span>
        <strong>{next.title}</strong>
      </a>
    </nav>
  </article>
</Base>

<script>
  const viewer = document.querySelector<HTMLDialogElement>('dialog.viewer');
  const big = viewer?.querySelector('img');
  // La versión más grande disponible del srcset
  const largest = (img: HTMLImageElement) =>
    img.srcset
      ? img.srcset
          .split(',')
          .map((c) => c.trim().split(/\s+/))
          .sort((a, b) => parseInt(b[1]) - parseInt(a[1]))[0][0]
      : img.currentSrc || img.src;
  document.querySelectorAll<HTMLImageElement>('.compose img, .bleed img, .bleed-only img, .pair img, .after img, .sheet img:not(.contact img), .backdrop img, .scroller img, .gallery img').forEach((img) => {
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    const open = () => {
      if (!viewer || !big) return;
      big.src = largest(img);
      big.alt = img.alt;
      viewer.showModal();
    };
    img.addEventListener('click', open);
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        open();
      }
    });
  });
  viewer?.addEventListener('click', () => viewer.close());
</script>

<style>
  .viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(16px, 4vw, 56px);
    border: 0;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    cursor: zoom-out;
  }
  .viewer[open] {
    display: grid;
    place-items: center;
  }
  .viewer::backdrop {
    background: transparent;
  }
  .viewer img {
    max-width: 100%;
    max-height: calc(100dvh - 2 * clamp(16px, 4vw, 56px));
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .viewer-close {
    position: fixed;
    top: 20px;
    right: var(--gutter);
    font: inherit;
    font-size: 15px;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
  }

  .project {
    padding: 112px var(--gutter) 72px;
  }
  .crumbs {
    display: flex;
    gap: 20px;
  }
  .back {
    font-size: 14px;
    color: var(--ink-2);
    text-decoration: none;
  }
  .back:hover {
    color: var(--minio);
  }
  h1 {
    margin: 16px 0 0;
    font-size: clamp(40px, 7vw, 96px);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }
  .sub {
    margin: 12px 0 0;
    font-size: clamp(18px, 1.8vw, 24px);
    color: var(--ink-2);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    margin: 32px 0 56px;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }
  .facts dt {
    font-size: 13px;
    color: var(--ink-3);
  }
  .facts dd {
    margin: 0;
  }
  .text {
    max-width: 64ch;
    margin: 40px 0 56px;
    font-size: 18px;
  }
  .text p {
    margin: 0 0 1em;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .links a {
    display: inline-block;
    padding: 7px 16px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    text-decoration: none;
    font-size: 15px;
  }
  .links a:hover {
    background: var(--ink);
    color: var(--paper);
  }
  /* Galería sin recuadros: los dibujos se funden con el papel y se alinean
     a la retícula de 12 columnas */
  .gallery {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px 24px;
    align-items: end;
  }
  figure {
    margin: 0;
    grid-column: span 6;
  }
  figure {
    grid-column: span 4;
  }
  figure.full {
    grid-column: span 8;
  }
  figure.a {
    grid-column: span 5;
  }
  figure.b {
    grid-column: span 4;
  }
  figure.tall {
    grid-column: span 3;
  }
  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
    cursor: zoom-in;
  }
  @media (max-width: 700px) {
    .gallery {
      gap: 28px 16px;
    }
    figure,
    figure.a,
    figure.b,
    figure.full {
      grid-column: 1 / -1;
    }
    figure.tall {
      grid-column: span 6;
    }
  }
  .credit {
    font-size: 14px;
    color: var(--ink-3);
  }
  .next {
    margin-top: 72px;
    padding-top: 20px;
    border-top: 1px solid var(--ink);
  }
  .next a {
    display: grid;
    gap: 4px;
    text-decoration: none;
  }
  .next span {
    font-size: 14px;
    color: var(--ink-3);
  }
  .next strong {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 560;
    letter-spacing: -0.02em;
  }
  .next a:hover strong {
    color: var(--minio);
  }
</style>
