---
import { Image } from 'astro:assets';
import { experiences, skills, lines, PRESENT_YEAR, archive, archiveGroups, archivePending } from '../data/content';
import { imagesFor, url } from '../lib/images';

const from = Math.min(...experiences.map((e) => e.start));
const payload = JSON.stringify({ experiences, skills, lines, from, to: PRESENT_YEAR });
const groups = (['etsam', 'unav'] as const).map((g) => ({
  id: g,
  ...archiveGroups[g],
  items: archive.filter((p) => p.group === g),
  pending: archivePending.filter((p) => p.group === g),
}));
const otherImgs = imagesFor('other').slice(0, 8);
---

<section id="path" class="network" aria-labelledby="path-title">
  <script type="application/json" set:html={payload} />
  <div class="sticky">
    <header class="head">
      <div>
        <h2 id="path-title">Path</h2>
        <p>
          Each place I have worked or studied connects to what I learned there. The more connections, the bigger the
          node. Scroll to move through time; open the outlined bubbles to see what is inside.
        </p>
      </div>
      <div class="controls">
        <span class="year" data-year aria-live="polite">{from}</span>
        <button type="button" data-present>Present</button>
      </div>
    </header>
    <div class="stage">
      <svg aria-hidden="true"></svg>
    </div>
  </div>
</section>

{
  groups.map((g) => (
    <dialog class="bubble" id={`bubble-${g.id}`} aria-labelledby={`bubble-${g.id}-title`}>
      <div class="bubble-inner">
        <header>
          <div>
            <h3 id={`bubble-${g.id}-title`}>{g.title}</h3>
            <p>
              {g.subtitle}, {g.years}
            </p>
          </div>
          <button type="button" data-close>
            Close
          </button>
        </header>
        <ul class="grid">
          {g.items.map((p) => {
            const cover = imagesFor(p.slug)[0];
            return (
              <li>
                <a href={url(`archive/${p.slug}/`)}>
                  {cover && <Image src={cover} alt="" widths={[360, 720]} sizes="(max-width: 700px) 50vw, 25vw" />}
                  <strong>{p.title}</strong>
                  <span>{p.subtitle}</span>
                </a>
              </li>
            );
          })}
          {g.pending.map((p) => (
            <li class="pending">
              <div class="ph" />
              <strong>{p.title}</strong>
              <span>{p.subtitle}</span>
            </li>
          ))}
        </ul>
      </div>
    </dialog>
  ))
}

<dialog class="bubble" id="bubble-other" aria-labelledby="bubble-other-title">
  <div class="bubble-inner">
    <header>
      <div>
        <h3 id="bubble-other-title">Other stuff</h3>
        <p>Graphic design for friends and family: logos, invitations, seating plans, illustration.</p>
      </div>
      <button type="button" data-close>Close</button>
    </header>
    <ul class="grid other">
      {
        otherImgs.map((img) => (
          <li>
            <Image src={img} alt="" widths={[360, 720]} sizes="(max-width: 700px) 50vw, 25vw" />
          </li>
        ))
      }
    </ul>
    <p class="more"><a href={url('other/')}>See everything</a></p>
  </div>
</dialog>

<script>
  import { initNetwork, initBubbles } from '../scripts/network.js';
  const root = document.querySelector<HTMLElement>('#path');
  if (root) initNetwork(root);
  initBubbles();
</script>

<style>
  .network {
    position: relative;
    height: 280vh;
    border-top: 1px solid var(--line);
  }
  .sticky {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 16px;
    padding: 88px var(--gutter) 24px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px 40px;
    flex-wrap: wrap;
  }
  .head > div:first-child {
    display: grid;
    gap: 8px;
    max-width: 62ch;
  }
  h2 {
    margin: 0;
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 560;
    letter-spacing: -0.02em;
  }
  .head p {
    margin: 0;
    color: var(--ink-2);
  }
  .stage {
    position: relative;
    min-height: 0;
  }
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .year {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .controls button,
  .bubble button {
    font: inherit;
    font-size: 15px;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
  }
  .controls button:hover {
    background: var(--minio);
    border-color: var(--minio);
  }

  /* --- SVG --- */
  .network :global(.axis line) {
    stroke: var(--ink-3);
  }
  .network :global(.axis text) {
    fill: var(--ink-3);
    font-size: 12px;
  }
  .network :global(.edge) {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1;
    opacity: 0.7;
  }
  .network :global(.spans line) {
    stroke: var(--ink);
    stroke-width: 2;
  }
  .network :global(.skill circle) {
    fill: var(--paper);
    stroke: var(--ink-3);
    transition: r 0.35s ease;
  }
  .network :global(.skill.on circle) {
    fill: var(--ink);
    stroke: var(--ink);
  }
  .network :global(.skill text) {
    font-size: 12.5px;
    fill: var(--ink-3);
  }
  .network :global(.skill.on text) {
    fill: var(--ink);
  }
  .network :global(.exp) {
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .network :global(.exp.on) {
    opacity: 1;
  }
  .network :global(.exp .dot) {
    fill: var(--ink);
  }
  .network :global(.exp .halo) {
    fill: none;
    stroke: var(--ink);
    stroke-dasharray: 2 3;
  }
  .network :global(.exp text) {
    font-size: 14px;
    font-weight: 500;
    fill: var(--ink);
  }
  .network :global(.is-vertical .skill text) {
    font-size: 11.5px;
  }
  .network :global(.is-vertical .exp text) {
    font-size: 12px;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 4px;
  }
  .network :global(.exp.can-open) {
    cursor: pointer;
  }
  .network :global(.exp.can-open:hover .dot),
  .network :global(.exp.can-open:focus-visible .dot) {
    fill: var(--minio);
  }
  .network :global(.exp.can-open:hover .halo),
  .network :global(.exp.can-open:focus-visible .halo) {
    stroke: var(--minio);
    stroke-dasharray: none;
  }
  .network :global(.exp:focus) {
    outline: none;
  }

  /* --- Burbuja: se abre como un círculo desde el nodo --- */
  .bubble {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    clip-path: circle(0 at var(--x, 50%) var(--y, 50%));
    transition:
      clip-path 0.6s cubic-bezier(0.6, 0, 0.2, 1),
      overlay 0.6s allow-discrete,
      display 0.6s allow-discrete;
  }
  .bubble[open] {
    clip-path: circle(150% at var(--x, 50%) var(--y, 50%));
  }
  @starting-style {
    .bubble[open] {
      clip-path: circle(0 at var(--x, 50%) var(--y, 50%));
    }
  }
  .bubble::backdrop {
    background: transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    .bubble {
      transition: none;
    }
  }
  .bubble-inner {
    height: 100%;
    overflow-y: auto;
    padding: 32px var(--gutter) 48px;
  }
  .bubble header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 24px;
    margin-bottom: 32px;
  }
  .bubble h3 {
    margin: 0;
    font-size: clamp(36px, 6vw, 72px);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .bubble header p {
    margin: 10px 0 0;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 45%), 1fr));
    gap: 32px 20px;
  }
  .grid a,
  .grid .pending {
    display: grid;
    gap: 6px;
    text-decoration: none;
  }
  .grid :global(img),
  .grid .ph {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #fff;
    border: 1px solid var(--line);
  }
  .grid .ph {
    background: repeating-linear-gradient(45deg, transparent 0 6px, var(--line) 6px 7px);
  }
  .grid.other :global(img) {
    object-fit: contain;
    padding: 12px;
  }
  .grid strong {
    font-weight: 560;
  }
  .grid span {
    color: var(--ink-2);
    font-size: 14px;
  }
  .grid a:hover strong {
    color: var(--minio);
  }
  .more {
    margin-top: 32px;
  }
</style>
