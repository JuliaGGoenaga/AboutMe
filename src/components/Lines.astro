---
// Las tres líneas como tres círculos que se solapan: el solape es el tema del PhD.
// Al bajar por "Present" se abren una a una las tarjetas de cada línea y, al
// final, se destaca el centro: Humanizing decarbonization. Tocar o enfocar un
// título también abre su tarjeta.
import { lines } from '../data/content';

// Centros de los círculos en un lienzo de 600 x 560 (triángulo equilátero).
const centers = [
  { x: 210, y: 210 },
  { x: 390, y: 210 },
  { x: 300, y: 366 },
];
const R = 165;
// Posición de cada título, empujado hacia fuera del solape.
const labels = [
  { x: 150, y: 160 },
  { x: 450, y: 160 },
  { x: 300, y: 450 },
];
// Dónde se abre la tarjeta de cada línea: hacia fuera de su círculo.
const anchors = ['left', 'right', 'bottom'];
---

<div class="lines" data-lines>
  <svg viewBox="0 0 600 560" aria-hidden="true">
    {centers.map((c, i) => <circle class="disc" data-i={i} cx={c.x} cy={c.y} r={R} />)}
    <circle class="heart" cx="300" cy="262" r="62" />
  </svg>
  {
    lines.map((l, i) => (
      <button
        type="button"
        class="label"
        data-i={i}
        aria-expanded="false"
        aria-controls={`line-card-${i}`}
        style={`left:${(labels[i].x / 600) * 100}%;top:${(labels[i].y / 560) * 100}%`}
      >
        {l.title}
      </button>
    ))
  }
  <p class="core" style={`left:50%;top:${(262 / 560) * 100}%`}>
    <span>PhD</span>
    Humanizing decarbonization
  </p>

  {
    lines.map((l, i) => (
      <div class={`card at-${anchors[i]}`} id={`line-card-${i}`} data-i={i} role="tooltip">
        <h3>{l.title}</h3>
        <p>{l.summary}</p>
        <ul>
          {l.work.map((w) => (
            <li>{w}</li>
          ))}
        </ul>
      </div>
    ))
  }
  <div class="card at-core" id="line-card-3" data-i="3" role="tooltip">
    <h3>Humanizing decarbonization</h3>
    <p>
      Where the three lines meet: my PhD on a performance-driven optimization workflow in envelope design, bringing AI
      and simulation into the earliest design decisions.
    </p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lines]').forEach((root) => {
    const discs = root.querySelectorAll<SVGCircleElement>('.disc');
    const labels = root.querySelectorAll<HTMLButtonElement>('.label');
    const cards = root.querySelectorAll<HTMLElement>('.card');
    let active: string | null = null;

    const show = (i: string | null) => {
      active = i;
      root.classList.toggle('has-active', i !== null);
      root.classList.toggle('core-on', i === '3');
      discs.forEach((d) => d.classList.toggle('on', d.dataset.i === i));
      labels.forEach((b) => b.setAttribute('aria-expanded', String(b.dataset.i === i)));
      cards.forEach((c) => c.classList.toggle('open', c.dataset.i === i));
    };

    // Scroll: el avance por la sección "Present" abre las tarjetas en orden y,
    // al final, destaca el centro.
    // En el móvil el diagrama va después del texto, con su propio recorrido
    const section = root.closest('section');
    const narrow = matchMedia('(max-width: 900px)');
    let manual = false;
    const onScroll = () => {
      const track = narrow.matches ? root.closest<HTMLElement>('.lines-track') ?? section : section;
      if (!track || manual) return;
      const r = track.getBoundingClientRect();
      const k = Math.min(Math.max(-r.top / Math.max(r.height - innerHeight, 1), 0), 1);
      const stage = r.top > innerHeight * 0.35 ? null : k < 0.25 ? '0' : k < 0.5 ? '1' : k < 0.75 ? '2' : '3';
      if (stage !== active) show(stage);
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Táctil y teclado: tocar o pulsar abre y cierra.
    const pick = (i: string | null) => {
      manual = true;
      show(i);
    };
    labels.forEach((b) => {
      b.addEventListener('click', () => pick(b.dataset.i ?? null));
      b.addEventListener('focus', () => pick(b.dataset.i ?? null));
    });
    discs.forEach((d) => d.addEventListener('click', () => pick(d.dataset.i ?? null)));
    // Al volver a hacer scroll, manda otra vez el scroll
    addEventListener('wheel', () => (manual = false), { passive: true });
    addEventListener('touchmove', () => (manual = false), { passive: true });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        manual = false;
        onScroll();
      }
    });
  });
</script>

<style>
  .lines {
    position: relative;
    width: 100%;
    width: min(600px, 38vw, calc((100dvh - 150px) * 1.07));
    justify-self: end;
    /* Hueco a la izquierda para la tarjeta */
    margin-left: 300px;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .disc {
    fill: var(--paper-2);
    fill-opacity: 0.35;
    stroke: var(--ink);
    stroke-width: 1;
    cursor: pointer;
    mix-blend-mode: multiply;
    transition:
      fill 0.3s ease,
      fill-opacity 0.3s ease,
      stroke 0.3s ease,
      opacity 0.3s ease;
  }
  .has-active .disc:not(.on) {
    opacity: 0.45;
  }
  .heart {
    fill: var(--minio);
    fill-opacity: 0;
    stroke: var(--minio);
    stroke-opacity: 0;
    transition:
      fill-opacity 0.5s ease,
      stroke-opacity 0.5s ease;
    pointer-events: none;
  }
  .core-on .heart {
    fill-opacity: 0.16;
    stroke-opacity: 1;
  }
  .core-on .disc {
    opacity: 1;
    stroke: var(--minio);
  }
  .disc.on {
    fill: var(--minio);
    fill-opacity: 0.12;
    stroke: var(--minio);
    stroke-width: 1.5;
  }
  .label {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 11em;
    padding: 6px;
    border: 0;
    background: none;
    font: inherit;
    font-size: clamp(15px, 1.5vw, 19px);
    font-weight: 540;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-align: center;
    color: var(--ink);
    cursor: pointer;
  }
  .label[aria-expanded='true'] {
    color: var(--minio);
  }
  .core {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 8.5em;
    margin: 0;
    text-align: center;
    font-size: clamp(11px, 1vw, 13px);
    line-height: 1.25;
    color: var(--ink-2);
    pointer-events: none;
  }
  .core {
    transition:
      color 0.4s ease,
      font-size 0.4s ease;
  }
  .core-on .core {
    color: var(--minio);
    font-weight: 560;
    font-size: clamp(13px, 1.3vw, 16px);
  }
  .core span {
    display: block;
    font-size: 11px;
    color: var(--ink-3);
  }

  /* Tarjeta: papel translúcido con desenfoque, como una lámina de croquis encima */
  .card {
    position: absolute;
    z-index: 2;
    width: min(320px, 78%);
    padding: 20px 22px 18px;
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
    border: 1px solid var(--ink);
    box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--ink) 45%, transparent);
    pointer-events: none;
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }
  .card.open {
    opacity: 1;
    transform: none;
  }
  /* La tarjeta se abre a la izquierda del diagrama, en el hueco junto al texto */
  .card {
    left: auto;
    right: calc(100% + 24px);
    top: 50%;
    width: 276px;
    transform: translateY(calc(-50% + 8px)) scale(0.98);
  }
  .card.open {
    transform: translateY(-50%);
  }
  .card h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 560;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--minio);
  }
  .card p {
    margin: 8px 0 0;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .card ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    border-top: 1px solid var(--ink);
    font-size: 14px;
  }
  .card li {
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
  }
  .card li:last-child {
    border-bottom: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .disc {
      transition: none;
    }
  }
  /* En el móvil la tarjeta vuelve debajo del diagrama */
  @media (max-width: 900px) {
    .lines {
      justify-self: center;
      width: 100%;
      max-width: min(480px, calc((100dvh - 380px) * 1.07));
      margin-left: 0;
    }
    .card {
      right: auto;
      left: 0;
      top: calc(100% + 8px);
      width: 100%;
      transform: translateY(8px) scale(0.98);
    }
    .card.open {
      transform: none;
    }
  }
</style>
