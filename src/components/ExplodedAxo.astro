---
// Axonometría explotada interactiva: una lupa sigue al puntero y los puntos
// numerados explican cada pieza del sistema constructivo.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  title: string;
  intro: string;
  spots: { x: number; y: number; label: string; text: string }[];
}
const { src, title, intro, spots } = Astro.props;
---

<section class="axo" data-axo aria-labelledby="axo-title">
  <header>
    <h2 id="axo-title">{title}</h2>
    <p>{intro}</p>
  </header>
  <div class="stage" data-stage style={`--full:url(${src.src})`}>
    <Image src={src} alt="Exploded axonometric of the building and its precast structure" widths={[1280, 1920, 2560]} sizes="(max-width: 900px) 100vw, 75vw" />
    <div class="lens" aria-hidden="true"></div>
    {
      spots.map((s, i) => (
        <button type="button" class="spot" style={`left:${s.x}%;top:${s.y}%`} data-i={i} aria-describedby={`axo-note-${i}`}>
          <span>{i + 1}</span>
        </button>
      ))
    }
    {
      spots.map((s, i) => (
        <div class="note" id={`axo-note-${i}`} role="tooltip" data-i={i} style={`left:${s.x}%;top:${s.y}%`} data-side={s.x > 55 ? 'left' : 'right'}>
          <strong>{s.label}</strong>
          <p>{s.text}</p>
        </div>
      ))
    }
  </div>
  <ol class="legend">
    {
      spots.map((s, i) => (
        <li data-i={i}>
          <span>{i + 1}</span>
          {s.label}
        </li>
      ))
    }
  </ol>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-axo]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const lens = root.querySelector<HTMLElement>('.lens')!;
    const notes = root.querySelectorAll<HTMLElement>('.note');
    const spots = root.querySelectorAll<HTMLElement>('.spot');
    const items = root.querySelectorAll<HTMLElement>('.legend li');
    const ZOOM = 2.6;

    // Lupa: muestra la versión a máxima resolución bajo el puntero.
    stage.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = stage.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      lens.style.left = `${x}px`;
      lens.style.top = `${y}px`;
      lens.style.backgroundSize = `${r.width * ZOOM}px ${r.height * ZOOM}px`;
      lens.style.backgroundPosition = `${-x * ZOOM + lens.offsetWidth / 2}px ${-y * ZOOM + lens.offsetHeight / 2}px`;
      stage.classList.add('looking');
    });
    stage.addEventListener('pointerleave', () => stage.classList.remove('looking'));

    const show = (i: string | null) => {
      notes.forEach((n) => n.classList.toggle('open', n.dataset.i === i));
      spots.forEach((s) => s.classList.toggle('on', s.dataset.i === i));
      items.forEach((s) => s.classList.toggle('on', s.dataset.i === i));
    };
    spots.forEach((s) => {
      s.addEventListener('pointerenter', () => show(s.dataset.i ?? null));
      s.addEventListener('focus', () => show(s.dataset.i ?? null));
      s.addEventListener('click', () => show(s.dataset.i ?? null));
      s.addEventListener('pointerleave', () => show(null));
      s.addEventListener('blur', () => show(null));
    });
    items.forEach((s) => {
      s.addEventListener('pointerenter', () => show(s.dataset.i ?? null));
      s.addEventListener('pointerleave', () => show(null));
    });
  });
</script>

<style>
  .axo {
    margin: 0 0 88px;
  }
  header {
    max-width: 62ch;
    margin-bottom: 20px;
  }
  h2 {
    margin: 0;
    font-size: clamp(24px, 2.6vw, 34px);
    font-weight: 560;
    letter-spacing: -0.015em;
  }
  header p {
    margin: 8px 0 0;
    color: var(--ink-2);
  }
  .stage {
    position: relative;
    cursor: crosshair;
  }
  .stage :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }
  .lens {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    background-color: #fff;
    background-image: var(--full);
    background-repeat: no-repeat;
    box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--ink) 50%, transparent);
    translate: -50% -50%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
    z-index: 2;
  }
  .stage.looking .lens {
    opacity: 1;
  }
  .spot {
    position: absolute;
    translate: -50% -50%;
    width: 26px;
    height: 26px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--minio);
    background: var(--paper);
    color: var(--minio);
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: help;
    z-index: 3;
  }
  .spot.on,
  .spot:hover,
  .spot:focus-visible {
    background: var(--minio);
    color: var(--paper);
  }
  .note {
    position: absolute;
    z-index: 4;
    width: min(280px, 40vw);
    padding: 14px 16px;
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--ink);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
    translate: 22px -50%;
  }
  .note[data-side='left'] {
    translate: calc(-100% - 22px) -50%;
  }
  .note.open {
    opacity: 1;
  }
  .note strong {
    color: var(--minio);
    font-weight: 560;
  }
  .note p {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .legend {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: 6px 24px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .legend li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .legend li span {
    color: var(--minio);
    font-weight: 600;
    min-width: 1.4em;
  }
  .legend li.on {
    color: var(--ink);
  }
  @media (max-width: 760px) {
    .lens {
      display: none;
    }
    .note {
      width: 70vw;
    }
  }
</style>
