---
// Axonometría explotada: el dibujo completo con puntos numerados. Al pasar por
// un número (o tocarlo) se destaca y su explicación aparece en la leyenda.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  title: string;
  intro: string;
  spots: { x: number; y: number; label: string; text: string }[];
  // Dentro de una columna: leyenda debajo del dibujo
  stacked?: boolean;
}
const { src, title, intro, spots, stacked = false } = Astro.props;
---

<section class:list={['axo', { stacked }]} data-axo aria-labelledby="axo-title">
  <header>
    <h2 id="axo-title">{title}</h2>
    <p>{intro}</p>
  </header>
  <div class="body">
    <div class="stage">
      <Image src={src} alt="Exploded axonometric of the building and its precast structure" widths={[1280, 1920, 2560]} sizes="(max-width: 900px) 100vw, 70vw" />
      {
        spots.map((s, i) => (
          <button type="button" class="spot" style={`left:${s.x}%;top:${s.y}%`} data-i={i} aria-describedby={`axo-note-${i}`}>
            <span>{i + 1}</span>
          </button>
        ))
      }
    </div>
    <ol class="legend">
      {
        spots.map((s, i) => (
          <li data-i={i} id={`axo-note-${i}`}>
            <span>{i + 1}</span>
            <div>
              <strong>{s.label}</strong>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-axo]').forEach((root) => {
    const spots = root.querySelectorAll<HTMLElement>('.spot');
    const items = root.querySelectorAll<HTMLElement>('.legend li');
    const show = (i: string | null) => {
      spots.forEach((s) => s.classList.toggle('on', s.dataset.i === i));
      items.forEach((s) => s.classList.toggle('on', s.dataset.i === i));
    };
    [...spots, ...items].forEach((s) => {
      s.addEventListener('pointerenter', () => show(s.dataset.i ?? null));
      s.addEventListener('pointerleave', () => show(null));
    });
    spots.forEach((s) => {
      s.addEventListener('focus', () => show(s.dataset.i ?? null));
      s.addEventListener('click', () => show(s.dataset.i ?? null));
      s.addEventListener('blur', () => show(null));
    });
  });
</script>

<style>
  .axo {
    margin: 0 0 88px;
  }
  header {
    max-width: 70ch;
    margin-bottom: 16px;
  }
  h2 {
    margin: 0;
    font-size: clamp(22px, 2.4vw, 32px);
    font-weight: 560;
    letter-spacing: -0.015em;
  }
  header p {
    margin: 6px 0 0;
    color: var(--ink-2);
    font-size: 15px;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 9fr) minmax(0, 3fr);
    gap: 32px;
    align-items: center;
  }
  .stage {
    position: relative;
  }
  .stage :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }
  .spot {
    position: absolute;
    translate: -50% -50%;
    width: 24px;
    height: 24px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--minio);
    background: var(--paper);
    color: var(--minio);
    font: inherit;
    font-size: 11.5px;
    font-weight: 600;
    cursor: help;
  }
  .spot.on,
  .spot:hover,
  .spot:focus-visible {
    background: var(--minio);
    color: var(--paper);
  }
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .legend li {
    display: grid;
    grid-template-columns: 1.6em 1fr;
    gap: 6px;
  }
  .legend li > span {
    color: var(--minio);
    font-weight: 600;
  }
  .legend strong {
    font-weight: 540;
    color: var(--ink);
  }
  .legend p {
    margin: 2px 0 0;
    line-height: 1.4;
  }
  .legend li:not(.on) p {
    display: none;
  }
  .legend li.on strong {
    color: var(--minio);
  }
  .stacked {
    margin-bottom: 0;
  }
  .stacked .body {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .stacked .legend {
    grid-template-columns: repeat(auto-fill, minmax(min(230px, 100%), 1fr));
    gap: 8px 24px;
    align-items: start;
  }
  .stacked .legend li:not(.on) p {
    display: block;
  }
  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
    }
    .legend li:not(.on) p {
      display: block;
    }
  }
</style>
