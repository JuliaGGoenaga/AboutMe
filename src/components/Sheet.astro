---
// Lámina de proyecto: cada proyecto define su propia retícula en src/data/sheets.ts.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { ArchiveProject } from '../data/content';
import { sheets } from '../data/sheets';
import ExplodedAxo from './ExplodedAxo.astro';

interface Props {
  project: ArchiveProject;
}
const { project: p } = Astro.props;
const sheet = sheets[p.slug];

const archiveImgs = import.meta.glob<{ default: ImageMetadata }>('../assets/archive/*/*.jpg', { eager: true });
const composeImgs = import.meta.glob<{ default: ImageMetadata }>('../assets/compose/*/*.jpg', { eager: true });
const ref = (r: string) =>
  r.startsWith('a:')
    ? archiveImgs[`../assets/archive/${p.slug}/${r.slice(2)}.jpg`]?.default
    : composeImgs[`../assets/compose/${p.slug}/${r.slice(2)}.jpg`]?.default;
const many = (prefix: string) =>
  Object.entries(composeImgs)
    .filter(([path]) => path.includes(`/compose/${p.slug}/${prefix}`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, m]) => m.default);

const W = [400, 800, 1600, 2400];
const gridStyle = `grid-template-columns:${sheet.columns};grid-template-areas:${sheet.areas.map((a) => `"${a}"`).join(' ')}`;
const cells = Object.entries(sheet.cells);
---

{
  sheet.backdrop && (
    <section class="backdrop" aria-label="Situation">
      <Image src={ref(sheet.backdrop)} alt={`${p.title}, situation plan`} widths={[1280, 1920, 2800]} sizes="100vw" loading="eager" />
      <div class="veil">
        <div class="text">
          {p.text.map((t) => (
            <p>{t}</p>
          ))}
        </div>
        {p.links && (
          <ul class="links">
            {p.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}


{
  sheet.bleed && (
    <section class="bleed-only" aria-label="Poster">
      <Image src={ref(sheet.bleed)} alt={`${p.title}, competition poster`} widths={[1280, 1920, 2400]} sizes="100vw" loading="eager" />
    </section>
  )
}

{
  sheet.lead && (
    <section class="after lead" aria-label="Section">
      {sheet.lead.map((r) => (
        <Image src={ref(r)} alt={`${p.title}, section`} widths={[1280, 1920, 3000]} sizes="100vw" />
      ))}
    </section>
  )
}

{
  sheet.pair && (
    <section class="pair" aria-label="Posters">
      {sheet.pair.map((r) => (
        <Image src={ref(r)} alt={`${p.title}, poster`} widths={[960, 1600, 2000]} sizes="50vw" loading="eager" />
      ))}
    </section>
  )
}

{
  !sheet.bleed && !sheet.pair && (
<section class="sheet" style={gridStyle} aria-label="Project drawings">
  {
    cells.map(([area, value], i) => (
      <div
        class={`cell ${typeof value === 'string' && !value.includes(':') ? value : ''} ${sheet.sticky?.includes(area) ? 'is-sticky' : ''}`}
        style={`grid-area:${area};align-self:${sheet.align?.[area] ?? 'start'}${sheet.maxw?.[area] ? `;max-width:${sheet.maxw[area]};justify-self:${area === 's36' ? 'end' : 'start'}` : ''}`}
      >
        {value === 'text' && (
          <>
            <div class="text">
              {p.text.map((t) => (
                <p>{t}</p>
              ))}
            </div>
            {p.links && (
              <ul class="links">
                {p.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </>
        )}

        {value === 'catalogue' && (
          <>
            <p class="block-head">Catalogue of pixels. Sixteen modules of the BioPix envelope, pages 56 to 71 of the thesis.</p>
            <ol class="sheets" data-group="catalogue">
              {many('px-').map((src, k) => (
                <li>
                  <Image src={src} alt={`Catalogue sheet, pixel ${k + 1}`} widths={[240, 480, 1200]} sizes="(max-width: 700px) 25vw, 16vw" loading={k < 8 ? 'eager' : 'lazy'} />
                </li>
              ))}
            </ol>
          </>
        )}

        {value === 'typologies' && (
          <>
            <ol class="typs">
              {many('typ-').map((src, k) => (
                <li>
                  <p class="typ-title">Type {k + 1} in use</p>
                  <Image src={src} alt={`Housing typology ${k + 1} in use`} widths={[600, 1200, 2000]} sizes="(max-width: 900px) 100vw, 30vw" loading={k < 2 ? 'eager' : 'lazy'} />
                </li>
              ))}
            </ol>
          </>
        )}

        {value === 'carbon' && (
          <figure class="cq" aria-label="Highly efficient buildings, highly polluting buildings? Operational and embodied carbon">
            <p class="c-claim">Highly efficient buildings</p>
            <svg class="c-op" viewBox="0 0 200 150" aria-hidden="true">
              <path d="M10 10V140H190" class="axis" />
              <path d="M14 22C60 40 90 96 186 122" class="op" />
              <text x="186" y="112" text-anchor="end">operational</text>
              <text x="186" y="148" text-anchor="end">efficiency →</text>
            </svg>
            <div class="c-bar">
              <span class="v op-l">Operational carbon</span>
              <span class="v em-l">Embodied carbon</span>
            </div>
            <svg class="c-em" viewBox="0 0 200 150" aria-hidden="true">
              <path d="M10 10V140H190" class="axis" />
              <path d="M14 122C80 112 120 70 186 18" class="em" />
              <path d="M14 22C60 40 90 96 186 122" class="op ghost" />
              <text x="20" y="20">embodied?</text>
              <text x="186" y="148" text-anchor="end">efficiency →</text>
            </svg>
            <p class="c-claim c-q">Highly polluting buildings?</p>
          </figure>
        )}

        {value === 'axo' && sheet.axo && (
          <ExplodedAxo src={ref(sheet.axo.src)} title={sheet.axo.title} intro={sheet.axo.intro} spots={sheet.axo.spots} stacked />
        )}

        {value === 'flipbook' && (
          <ol class="contact">
            {many('ph-').map((src, k) => (
              <li>
                <Image src={src} alt={`Clay model study ${k + 1}`} widths={[164]} sizes="95px" loading={k < 16 ? 'eager' : 'lazy'} />
              </li>
            ))}
          </ol>
        )}

        {typeof value === 'string' && (value.startsWith('stack:') || value.startsWith('reveal:')) && (
          <div class={value.startsWith('reveal:') ? 'stack reveal' : 'stack'}>
            {value
              .slice(value.indexOf(':') + 1)
              .split(',')
              .map((r) => (
                <figure>
                  <Image src={ref(r)} alt={`${p.title}, drawing`} widths={[640, 1280, 2200]} sizes="(max-width: 900px) 100vw, 60vw" />
                  {sheet.captions?.[r] && <figcaption>{sheet.captions[r]}</figcaption>}
                </figure>
              ))}
          </div>
        )}

        {typeof value === 'string' && /^[ac]:/.test(value) && (
          <Image src={ref(value)} alt={`${p.title}, drawing`} widths={W} sizes="(max-width: 900px) 100vw, 50vw" loading={i < 3 ? 'eager' : 'lazy'} />
        )}

        {Array.isArray(value) && (
          <div class="row" style={`grid-template-columns:repeat(${value.length},minmax(0,1fr))`}>
            {value.map((r) => (
              <Image src={ref(r)} alt={`${p.title}, drawing`} widths={[400, 800, 1600]} sizes="(max-width: 900px) 33vw, 20vw" />
            ))}
          </div>
        )}
      </div>
    ))
  }
</section>
  )
}

{
  sheet.band && (
    <section class="band" data-group="band" aria-label="Drawings" style={`grid-template-columns:${sheet.band.refs.map((r) => `minmax(0,${sheet.band?.sameScale ? ref(r).width : 1}fr)`).join(' ')}`}>
      {sheet.band.refs.map((r, k) => (
        <figure>
          {sheet.band?.titles?.[k] && <figcaption>{sheet.band.titles[k]}</figcaption>}
          <Image src={ref(r)} alt={sheet.band?.titles?.[k] ?? `${p.title}, drawing`} widths={[600, 1200, 2000]} sizes="(max-width: 700px) 100vw, 33vw" />
        </figure>
      ))}
    </section>
  )
}

{
  sheet.after && (
    <section class="after" aria-label="Sections" style={sheet.afterWidth ? `--aw:${sheet.afterWidth}` : undefined}>
      {sheet.after.map((r) => (
        <Image src={ref(r)} alt={`${p.title}, section`} widths={[1280, 1920, 3000]} sizes="100vw" />
      ))}
    </section>
  )
}

{
  sheet.boxes && (
    <section class="boxes" data-group="details" aria-label="Constructive details">
      {sheet.boxes.map((row) => (
        <div class="boxrow">
          {row.map((r) => {
            const m = ref(r);
            return (
              <figure style={`flex:${(m.width / m.height).toFixed(4)} 1 0`}>
                <Image src={m} alt={`${p.title}, constructive detail`} widths={[400, 800, 1400]} sizes="(max-width: 700px) 50vw, 25vw" />
              </figure>
            );
          })}
        </div>
      ))}
    </section>
  )
}

{
  sheet.strip && (
    <section class="strip" data-group="models" aria-label="Model photos">
      {sheet.strip.map((r) => {
        const m = ref(r);
        return (
          <Image src={m} alt={`${p.title}, model photo`} widths={[320, 640, 1200]} sizes="(max-width: 700px) 33vw, 12vw" style={`flex:${(m.width / m.height).toFixed(4)} 1 0`} />
        );
      })}
    </section>
  )
}

{sheet.axo && !Object.values(sheet.cells).includes('axo') && <ExplodedAxo src={ref(sheet.axo.src)} title={sheet.axo.title} intro={sheet.axo.intro} spots={sheet.axo.spots} />}

<script>
  // Alzados que aparecen uno a uno al bajar
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }),
    { rootMargin: '0px 0px -15% 0px' }
  );
  document.querySelectorAll('.reveal figure').forEach((f) => io.observe(f));


</script>

<style>
  .stack {
    display: grid;
    gap: 40px;
  }
  .stack figure {
    margin: 0;
  }
  .stack figcaption {
    margin-top: 8px;
    font-size: 13px;
    color: var(--ink-3);
  }
  /* Alzados más pequeños, para verlos junto a las secciones bioclimáticas */
  .reveal {
    gap: 64px;
  }
  .reveal figure {
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 0.9s ease,
      transform 0.9s ease;
  }
  .reveal figure:global(.in) {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal figure {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
  .after {
    margin: 0 calc(-1 * var(--gutter)) 96px;
  }
  .after :global(img) {
    display: block;
    width: var(--aw, 100%);
    margin-inline: auto;
    height: auto;
    mix-blend-mode: multiply;
    cursor: zoom-in;
  }
  /* La pregunta del TFM: eficiente frente a contaminante, con la franja negra
     del carbono operacional y el embebido en medio */
  .cq {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr minmax(64px, 0.42fr) 1fr;
    grid-template-rows: auto auto;
    gap: 28px 32px;
    align-items: start;
  }
  .c-claim {
    margin: 0;
    font-size: clamp(26px, 3vw, 44px);
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .cq .c-claim:first-child {
    grid-column: 1;
    grid-row: 1;
  }
  .c-op {
    grid-column: 1;
    grid-row: 2;
    align-self: end;
  }
  .c-bar {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: stretch;
    min-height: 420px;
    background: var(--ink);
    color: var(--paper);
    display: flex;
    justify-content: space-between;
    padding: 18px 10px;
  }
  .c-bar .v {
    writing-mode: vertical-rl;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: clamp(13px, 1.3vw, 18px);
    font-weight: 500;
  }
  .c-bar .em-l {
    align-self: flex-end;
    color: var(--minio);
  }
  .c-em {
    grid-column: 3;
    grid-row: 1;
  }
  .c-q {
    grid-column: 3;
    grid-row: 2;
    align-self: end;
    text-align: right;
  }
  .cq svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .cq svg text {
    font: 400 10px var(--font);
    fill: var(--ink-3);
  }
  .cq .axis {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 0.8;
  }
  .cq .op,
  .cq .em {
    fill: none;
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .cq .op {
    stroke: var(--ink);
  }
  .cq .ghost {
    stroke-width: 1;
    stroke-dasharray: 3 4;
    opacity: 0.5;
  }
  .cq .em {
    stroke: var(--minio);
  }
  @media (max-width: 700px) {
    .cq {
      gap: 16px;
    }
    .c-bar {
      min-height: 300px;
    }
  }
  /* Fila de dibujos con título, a todo el ancho de la página */
  .band {
    display: grid;
    gap: 32px;
    align-items: start;
    margin: 0 0 96px;
  }
  .band figure {
    margin: 0;
  }
  .band figcaption {
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ink);
    font-size: 14px;
    font-weight: 540;
  }
  .band :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
    cursor: zoom-in;
  }
  @media (max-width: 700px) {
    .band {
      grid-template-columns: 1fr !important;
    }
  }
  /* Cajas de detalle constructivo: misma altura en cada fila, filete fino */
  .boxes {
    display: grid;
    gap: 14px;
    margin: 0 0 96px;
  }
  .boxrow {
    display: flex;
    gap: 14px;
  }
  .boxes figure {
    margin: 0;
    min-width: 0;
    border: 1px solid var(--line);
    padding: 8px;
  }
  .boxes :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
    cursor: zoom-in;
  }
  /* Tira de fotos de maqueta a lo ancho de la pantalla */
  .strip {
    display: flex;
    gap: 4px;
    margin: 0 calc(-1 * var(--gutter)) 96px;
  }
  .strip :global(img) {
    display: block;
    min-width: 0;
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }
  @media (max-width: 700px) {
    .boxrow {
      flex-wrap: wrap;
    }
    .boxrow figure {
      flex-basis: 40% !important;
    }
    .strip {
      overflow-x: auto;
    }
    .strip :global(img) {
      width: auto;
      height: 120px;
      flex: none !important;
    }
  }
  /* Hoja de contactos de las maquetas de Macael */
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 6px;
    max-width: 760px;
  }
  .contact :global(img) {
    mix-blend-mode: normal;
    cursor: default;
  }


  .pair {
    margin: 0 calc(-1 * var(--gutter)) 72px;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .pair :global(img) {
    display: block;
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }
  @media (max-width: 700px) {
    .pair {
      grid-template-columns: 1fr;
    }
  }
  .bleed-only {
    margin: 0 calc(-1 * var(--gutter)) 72px;
  }
  .bleed-only :global(img) {
    display: block;
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }
  /* Plano de fondo a sangre y tarjeta translúcida encima */
  .backdrop {
    position: relative;
    margin: 0 calc(-1 * var(--gutter)) 56px;
  }
  .backdrop :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
    cursor: zoom-in;
  }
  .veil {
    position: absolute;
    left: var(--gutter);
    top: 8%;
    width: min(380px, 36%);
    padding: 22px 24px 18px;
    background: color-mix(in srgb, var(--paper) 74%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid var(--ink);
  }
  .veil .text {
    max-width: none;
  }
  @media (max-width: 760px) {
    .backdrop {
      margin-bottom: 32px;
    }
    .veil {
      position: static;
      width: auto;
      margin: 20px var(--gutter) 0;
      padding: 0;
      border: 0;
      background: none;
      backdrop-filter: none;
    }
    .after {
      margin-bottom: 32px;
    }
    .sheet {
      gap: 28px !important;
      margin-bottom: 48px;
    }
    .reveal {
      gap: 28px;
    }
    .stack {
      gap: 24px;
    }
  }
  .sheet {
    display: grid;
    gap: 32px 28px;
    margin: 0 0 88px;
  }
  .cell {
    min-width: 0;
  }
  .cell.is-sticky {
    position: sticky;
    top: 96px;
  }
  .sheet :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
    cursor: zoom-in;
  }
  .text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 46ch;
  }
  .text p {
    margin: 0 0 0.9em;
  }
  .links {
    list-style: none;
    padding: 12px 0 0;
    margin: 8px 0 0;
    border-top: 1px solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .links a {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    text-decoration: none;
    font-size: 14px;
  }
  .links a:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .row {
    display: grid;
    gap: 12px;
    align-items: end;
  }
  .block-head {
    margin: 0 0 12px;
    font-size: 13px;
    color: var(--ink-3);
  }
  /* Catálogo: 4 x 4, las 16 hojas, con un filete fino */
  .sheets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px 14px;
  }
  .sheets :global(img) {
    border: 1px solid var(--line);
    background: #fff;
  }
  .sheets :global(img) {
    transition: transform 0.2s ease;
  }
  .sheets :global(img:hover) {
    transform: translateY(-3px);
  }
  /* Tipologías como en la lámina 06 del panel: dos columnas, tres filas */
  .typs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 32px;
    align-items: end;
  }
  .typ-title {
    margin: 0 0 8px;
    font-size: 12.5px;
    letter-spacing: 0.02em;
    color: var(--ink-3);
    text-align: center;
  }
  /* En pantallas estrechas la lámina se apila en el orden definido */
  @media (max-width: 900px) {
    .sheet {
      grid-template-columns: 1fr !important;
      grid-template-areas: none !important;
    }
    .cell {
      grid-area: auto !important;
    }
  }
  @media (max-width: 700px) {
    .typs {
      grid-template-columns: 1fr;
    }
    .sheets {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
